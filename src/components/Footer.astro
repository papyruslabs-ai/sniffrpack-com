---
const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--color-rule)] mt-32">
  <div class="mx-auto max-w-5xl px-6 py-10 flex flex-col md:flex-row md:items-center md:justify-between gap-6 text-sm text-[var(--color-muted)]">
    <div class="flex items-center gap-2">
      <svg width="18" height="18" viewBox="0 0 64 64" fill="currentColor" class="text-[var(--color-accent)]">
        <circle cx="20" cy="22" r="6"/>
        <circle cx="44" cy="22" r="6"/>
        <circle cx="12" cy="36" r="5"/>
        <circle cx="52" cy="36" r="5"/>
        <ellipse cx="32" cy="44" rx="14" ry="11"/>
      </svg>
      <span>Sniffr &middot; a <a href="https://papyruslabs.ai" class="underline decoration-[var(--color-rule)] hover:text-[var(--color-accent)] hover:decoration-[var(--color-accent)]">Papyrus Labs AI</a> product</span>
    </div>
    <div class="flex items-center gap-6">
      <a href="/roadmap" class="hover:text-[var(--color-accent)]">Roadmap</a>
      <a href="https://app.sniffrpack.com" class="hover:text-[var(--color-accent)]">App</a>
      <span>&copy; {year}</span>
    </div>
  </div>
</footer>
